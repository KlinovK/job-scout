<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.job-scout.collector</string>

    <key>ProgramArguments</key>
    <array>
        <string>__JOBSCOUT_PROJECT_DIR__/.venv/bin/python</string>
        <string>__JOBSCOUT_PROJECT_DIR__/main.py</string>
        <string>--once</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__JOBSCOUT_PROJECT_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>0</integer>
            <key>Minute</key>
            <integer>15</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>6</integer>
            <key>Minute</key>
            <integer>15</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>12</integer>
            <key>Minute</key>
            <integer>15</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>18</integer>
            <key>Minute</key>
            <integer>15</integer>
        </dict>
    </array>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>__JOBSCOUT_PROJECT_DIR__/logs/collector.log</string>

    <key>StandardErrorPath</key>
    <string>__JOBSCOUT_PROJECT_DIR__/logs/collector.error.log</string>
</dict>
</plist>
